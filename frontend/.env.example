# Local demo token is generated by npm run setup. Never set this in a hosted build.
VITE_LOCAL_TOKEN=
# Cognito is optional. Set these public values only after the test pool is available.
VITE_AUTH_MODE=
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
# Hosted deployments must use an HTTPS API URL.
VITE_API_BASE_URL=
