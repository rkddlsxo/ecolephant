# npm run setup creates a random loopback-only demo token.
ECOLEPHANT_AUTH_MODE=local
ECOLEPHANT_LOCAL_TOKEN=
ECOLEPHANT_STORAGE=sqlite
ECOLEPHANT_DATABASE=.data/ecolephant.sqlite3
ECOLEPHANT_ALLOWED_ORIGIN=http://localhost:5173
# DynamoDB Local / AWS (optional)
ECOLEPHANT_TABLE=ecolephant-local
AWS_ENDPOINT_URL_DYNAMODB=http://localhost:8000
AWS_DEFAULT_REGION=ap-northeast-2
# Required when AUTH_MODE=cognito; no local-token fallback.
ECOLEPHANT_JWT_ISSUER=
ECOLEPHANT_JWT_CLIENT_ID=
